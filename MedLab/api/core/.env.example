# Copia este archivo como ".env" y ajusta los valores.
APP_NAME="MedLab"
APP_ENV=local
# En producción: APP_ENV=production y HTTPS directo en Apache.

# Formato: servidor:puerto (si no pones puerto se usa 3306)
DATABASE_URL=localhost:3306
DATABASE_USER=usr_medlab
DATABASE_PSSW=REEMPLAZAR_POR_CLAVE_UNICA
DATABASE_NAME=MedLabDB
DATABASE_CHARSET=utf8mb4
